<Window
    x:Class="Tiny11Builder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tiny11 Builder - Créateur d'image Windows 11">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TitleArea" Padding="24,0,140,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7F8;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Grid.Column="1" Text="Tiny11 Builder" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Padding="16,24,16,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="ÉTAPES DU PROJET" FontSize="10" CharacterSpacing="160"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="14,0,0,18"/>
                    <ListView x:Name="StepRail" SelectionChanged="OnRailChanged">
                        <ListViewItem Tag="0">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Bienvenue" FontWeight="Medium"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="1">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Image Windows" FontWeight="Medium"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="2">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xE74C;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Composants" FontWeight="Medium"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="3">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Paramètres" FontWeight="Medium"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="4">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xE9D5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Récapitulatif" FontWeight="Medium"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="5">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xEC05;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Création" FontWeight="Medium"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="12">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="IMAGE SÉLECTIONNÉE" FontSize="10" CharacterSpacing="120"/>
                            <TextBlock x:Name="ImageBadge" Text="Aucune image sélectionnée" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Les fichiers sources ne sont pas modifiés." FontSize="12" Style="{StaticResource Secondary}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ResumeButton" Content="Reprendre la création" Click="OnResume" HorizontalAlignment="Stretch"
                            AutomationProperties.HelpText="Reprendre une création interrompue à partir de la progression enregistrée."/>
                    <Button x:Name="RecoverButton" Content="Nettoyer l'espace de travail" Click="OnRecover" HorizontalAlignment="Stretch"/>
                    <Button x:Name="UsbToolButton" Click="OnLaunchUsbTool" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEC8E;" FontSize="14"/>
                            <TextBlock Text="Créer Clé USB Bootable"/>
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="ThemeChoice" Header="Apparence" SelectionChanged="OnThemeChanged" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Système"/><ComboBoxItem Content="Clair"/><ComboBoxItem Content="Sombre"/>
                    </ComboBox>
                    <ComboBox x:Name="AccentColorChoice" Header="Couleur d'accentuation" SelectionChanged="OnAccentColorChanged" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Bleu Windows (Défaut)" Tag="#0078D4"/>
                        <ComboBoxItem Content="Violet Royal" Tag="#8764B8"/>
                        <ComboBoxItem Content="Vert Émeraude" Tag="#107C41"/>
                        <ComboBoxItem Content="Orange Coucher de soleil" Tag="#CA5010"/>
                        <ComboBoxItem Content="Rouge Carmin" Tag="#E81123"/>
                        <ComboBoxItem Content="Cyan Néon" Tag="#00B7C3"/>
                        <ComboBoxItem Content="Rose Fushia" Tag="#E3008C"/>
                    </ComboBox>
                    <StackPanel Spacing="4">
                        <HyperlinkButton x:Name="SupportButton" Content="Soutenir le développement" Click="OnSupport" Padding="0"
                                         AutomationProperties.HelpText="Soutien mensuel optionnel ou don unique. Toutes les fonctionnalités de l'application restent gratuites."/>
                        <HyperlinkButton Content="Projet d'origine ↗" NavigateUri="https://github.com/ntdevlabs/tiny11builder" Padding="0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="16,0,0,0"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <!-- Ligne fixe : Retour à gauche, Annuler à droite -->
                <Grid x:Name="ShellRow" Padding="28,0,28,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Click="OnBack" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,12,0,0"
                            Background="Transparent" BorderThickness="0" Padding="12,8" AutomationProperties.Name="Retour">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE72B;" FontSize="16" Opacity="{ThemeResource SubtleIconOpacity}"/>
                                <TextBlock Text="Retour" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Left" Modifiers="Menu"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <TextBlock x:Name="BusyText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,0,0" IsHitTestVisible="False"
                               Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               FontSize="12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource CriticalButtonStyle}" Visibility="Collapsed" Click="OnCancel"
                            VerticalAlignment="Top" Margin="0,12,0,0" Padding="14,8" AutomationProperties.Name="Annuler en toute sécurité">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Annuler en toute sécurité"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="32,12,32,0">
                    <InfoBar.ActionButton>
                        <Button x:Name="NoticeButton" Click="OnNoticeAction" Visibility="Collapsed"/>
                    </InfoBar.ActionButton>
                </InfoBar>
                <ScrollViewer x:Name="ContentScroller" Grid.Row="2" Padding="40,24,40,20" HorizontalScrollBarVisibility="Disabled"
                              SizeChanged="OnContentSizeChanged" ViewChanged="OnContentViewChanged">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid x:Name="WelcomePanel" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="WelcomeTitle" Text="Bienvenue" FontSize="56" FontWeight="Light" Opacity="{ThemeResource WelcomeTitleOpacity}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="Level1"/>
                                <TextBlock Text="Créez un ISO Windows 11 personnalisé. Sélectionnez une image, choisissez ce que vous souhaitez retirer et générez votre ISO."
                                           FontSize="16" Style="{StaticResource Secondary}"/>
                            </StackPanel>
                            <Grid Grid.Row="1" RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Modes de création" FontSize="18" FontWeight="SemiBold"/>
                                <Grid x:Name="ModeCards" Grid.Row="1" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/>
                                    </Grid.RowDefinitions>
                                    <Button x:Name="RegularModeCard" Style="{StaticResource ModeCard}" Tag="Tiny11" Click="OnModeCardClick"
                                            AutomationProperties.Name="Tiny11" AutomationProperties.HelpText="Sélectionner Tiny11 et choisir un ISO Windows.">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE7F4;" FontSize="64" HorizontalAlignment="Left"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <TextBlock Text="Tiny11" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Utilise les suppressions Tiny11 d'origine. Conserve Windows Update et la récupération."
                                                           Style="{StaticResource Secondary}" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="Mises à jour Windows conservées" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="CoreModeCard" Grid.Column="1" Style="{StaticResource ModeCard}" Tag="Tiny11Core" Click="OnModeCardClick"
                                            AutomationProperties.Name="Tiny11 Core" AutomationProperties.HelpText="Sélectionner Tiny11 Core et choisir un ISO Windows.">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE8B7;" FontSize="64" HorizontalAlignment="Left"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <TextBlock Text="Tiny11 Core" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Supprime la maintenance, la récupération et désactive Defender."
                                                           Style="{StaticResource Secondary}" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="Pour machines virtuelles de test uniquement" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="CustomModeCard" Grid.Column="2" Style="{StaticResource ModeCard}" Tag="Custom" Click="OnModeCardClick"
                                            AutomationProperties.Name="Personnalisé" AutomationProperties.HelpText="Sélectionner le mode Personnalisé et choisir un ISO Windows.">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE713;" FontSize="64" HorizontalAlignment="Left"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <TextBlock Text="Personnalisé" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Choisissez individuellement les applications, composants et services à retirer."
                                                           Style="{StaticResource Secondary}" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="Éléments protégés inclus" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="2" Padding="0,16,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Windows 11 22H2 ou supérieur · x64 et ARM64 · Insider / Canary" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="Testez toujours vos images Core et personnalisées dans une VM avant installation."
                                               Style="{StaticResource Secondary}" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <StackPanel x:Name="SourcePanel" Visibility="Collapsed" Spacing="20">
                            <TextBlock Text="Image Windows" Style="{StaticResource PageHeading}"/>
                            <TextBlock x:Name="SourceMode" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="Téléchargez la dernière version officielle de Windows 11 chez Microsoft, ou sélectionnez une image ISO ou un dossier d'installation extrait. Analysez l'image pour sélectionner une édition."
                                       Style="{StaticResource Secondary}"/>
                            <Grid x:Name="SourceCards" ColumnSpacing="16" RowSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="LocalMediaCard" Grid.Row="1" Style="{StaticResource Card}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Support d'installation local" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBox x:Name="SourcePathBox" Header="Fichier ISO ou dossier d'installation Windows" TextChanged="OnSourceChanged" PlaceholderText="Choisissez une image Windows 11"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="Choisir un ISO" Click="OnChooseIso"/>
                                        <Button Content="Choisir un dossier" Click="OnChooseSourceFolder"/>
                                        <Button Content="Analyser l'image" Click="OnInspect" Style="{StaticResource AccentButtonStyle}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="EditionChoice" Header="Édition à créer" DisplayMemberPath="Summary"
                                              SelectionChanged="OnEditionChanged" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                            <Grid x:Name="DownloadCard" RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button Style="{StaticResource ModeCard}" MinHeight="150" Click="OnDownloadLatest" AutomationProperties.Name="Télécharger le dernier Windows 11">
                                    <Grid ColumnSpacing="24" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE896;" FontSize="52" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="Télécharger le dernier Windows 11" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="LatestDownloadDescription" Text="ISO officiel Microsoft. Architecture et langue sélectionnées automatiquement." Style="{StaticResource Secondary}"/>
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="24" Opacity="{ThemeResource CardArrowOpacity}"/>
                                    </Grid>
                                </Button>
                                <ProgressBar Grid.Row="1" x:Name="DownloadBar" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="Progression du téléchargement"/>
                                <TextBlock Grid.Row="2" x:Name="DownloadStatus" Text="Ou utilisez un ISO déjà présent sur votre machine." Style="{StaticResource Secondary}"/>
                            </Grid>
                            </Grid>
                            <Expander Header="Autres téléchargements officiels Microsoft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Choisissez une langue sur la page de téléchargement Microsoft, puis collez le lien direct de l'ISO ici. Les liens expirent généralement après 24 heures."
                                               Style="{StaticResource Secondary}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <HyperlinkButton Content="Téléchargements Microsoft x64 ↗" NavigateUri="https://www.microsoft.com/software-download/windows11"/>
                                        <HyperlinkButton Content="Téléchargements Microsoft ARM64 ↗" NavigateUri="https://www.microsoft.com/software-download/windows11arm64"/>
                                    </StackPanel>
                                    <HyperlinkButton Content="Sélection officielle Insider / Canary ↗" NavigateUri="https://www.microsoft.com/software-download/windowsinsiderpreviewiso" Padding="0"/>
                                    <TextBox x:Name="DownloadUrlBox" Header="Lien direct officiel Microsoft vers l'ISO" PlaceholderText="https://software.download.prss.microsoft.com/...iso?..."/>
                                    <TextBox x:Name="PublishedHashBox" Header="Empreinte SHA-256 officielle (recommandé)" PlaceholderText="Copiez depuis la section Vérifier votre téléchargement de Microsoft"/>
                                    <Button Content="Télécharger l'ISO / reprendre" Click="OnDownload" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <StackPanel x:Name="CleanupPanel" Visibility="Collapsed" Spacing="18">
                            <TextBlock Text="Composants" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="Choisissez Tiny11, Tiny11 Core, ou personnalisez vos sélections avec Personnalisé. Chaque modification est consignée dans le journal." Style="{StaticResource Secondary}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="14">
                                    <ComboBox x:Name="ModeChoice" Visibility="Collapsed" SelectionChanged="OnModeChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="Tiny11"/>
                                        <ComboBoxItem Content="Tiny11 Core"/>
                                        <ComboBoxItem Content="Personnalisé"/>
                                    </ComboBox>
                                    <Grid x:Name="RemovalModeCards" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                                        <Button x:Name="Tiny11Selection" Style="{StaticResource ModeCard}" MinHeight="140" Click="OnRemovalModeClick" Tag="Tiny11" AutomationProperties.Name="Utiliser Tiny11">
                                            <StackPanel Spacing="12"><FontIcon Glyph="&#xE7F4;" FontSize="48" HorizontalAlignment="Left"/><TextBlock Text="Tiny11" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Suppressions d'origine. Mises à jour conservées." Style="{StaticResource Secondary}"/></StackPanel>
                                        </Button>
                                        <Button x:Name="CoreSelection" Grid.Column="1" Style="{StaticResource ModeCard}" MinHeight="140" Click="OnRemovalModeClick" Tag="Tiny11Core" AutomationProperties.Name="Utiliser Tiny11 Core">
                                            <StackPanel Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="48" HorizontalAlignment="Left"/><TextBlock Text="Tiny11 Core" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Essentiel uniquement. Pour VM de test." Style="{StaticResource Secondary}"/></StackPanel>
                                        </Button>
                                        <Button x:Name="CustomSelection" Grid.Column="2" Style="{StaticResource ModeCard}" MinHeight="140" Click="OnRemovalModeClick" Tag="Custom" AutomationProperties.Name="Utiliser Personnalisé">
                                            <StackPanel Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="48" HorizontalAlignment="Left"/><TextBlock Text="Personnalisé" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Sélectionnez chaque suppression manuellement." Style="{StaticResource Secondary}"/></StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="ModeDescription" Style="{StaticResource Secondary}"/>
                                    <InfoBar x:Name="CoreWarning" IsOpen="False" IsClosable="False" Severity="Warning" Title="Core supprime le support des mises à jour et la récupération."
                                             Message="Core supprime les fichiers de composants et WinRE, et désactive Windows Update et Defender. Vous ne pourrez pas ajouter de mises à jour, langues ou fonctionnalités par la suite. Testez l'image dans une VM."/>
                                    <TextBlock x:Name="CoreConsentStatus" Visibility="Collapsed" Text="Il vous sera demandé d'accepter les limitations de Core avant de continuer." Style="{StaticResource Secondary}"/>
                                    <TextBlock x:Name="SelectionCount" Style="{StaticResource Secondary}"/>
                                    <TextBlock x:Name="EstimatedSpaceText" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="CustomChoices" Visibility="Collapsed" Spacing="18">
                            <ToggleSwitch x:Name="CustomCoreCheck" Header="Appliquer les suppressions Core" OffContent="Conserver la maintenance, la récupération et Defender" OnContent="Supprimer la maintenance, la récupération et Defender" Toggled="OnCustomCoreChanged"/>
                            <TextBlock Text="Les groupes cochés sont supprimés ou désactivés. Les groupes décochés sont conservés. Pour des éléments individuels, utilisez la liste ci-dessous."
                                       Style="{StaticResource Secondary}"/>
                            <!-- Barre de profils de pré-sélection -->
                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Pré-sélections rapides des composants" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Cliquez sur un profil pour appliquer les sélections" Style="{StaticResource Hint}"/>
                                    </Grid>
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Column="0" HorizontalAlignment="Stretch" Click="OnPresetBalanced" ToolTipService.ToolTip="Supprime bloatwares et télémétrie tout en préservant le multimédia et les outils essentiels.">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                                <TextBlock Text="Équilibré (Recommandé)"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="OnPresetMinimal" ToolTipService.ToolTip="Suppression agressive pour des performances maximales et un système épuré.">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7C5;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="Minimal / Gamer"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="OnPresetPrivacy" ToolTipService.ToolTip="Neutralise la télémétrie, Copilot, Recall 24H2, Bing Search, Widgets, Edge et OneDrive.">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE727;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                                <TextBlock Text="Confidentialité"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Click="OnPresetAppsOnly" ToolTipService.ToolTip="Supprime uniquement les applications intégrées préinstallées.">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE74C;" FontSize="14"/>
                                                <TextBlock Text="Applications seules"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnSelectAllOptions" ToolTipService.ToolTip="Coche tous les composants affichés pour une suppression complète.">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8B9;" FontSize="14"/>
                                                <TextBlock Text="Tout cocher"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnDeselectAllOptions" ToolTipService.ToolTip="Décoche tout pour tout conserver dans Windows.">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                                <TextBlock Text="Tout décocher"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <ComboBox x:Name="OptionFilter" Header="Afficher les choix" SelectedIndex="0" SelectionChanged="OnOptionFilterChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Tous"/><ComboBoxItem Content="Applications intégrées"/><ComboBoxItem Content="Fonctionnalités facultatives"/>
                                <ComboBoxItem Content="Paramètres Windows"/><ComboBoxItem Content="Avancé / Outil d'origine"/>
                            </ComboBox>
                            <ItemsControl x:Name="OptionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,8">
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
